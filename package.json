{
  "name": "lij",
  "private": true,
  "description": "Lij: a 70-card deck (every 4 of 8 emblems), print files and web games",
  "scripts": {
    "build": "node scripts/build.js",
    "pdf": "cd dist && node ../scripts/pdf.js",
    "sheet": "cd dist && node ../scripts/sheet.js \"\" contact-sheet.png",
    "test": "npm run build && cd dist && node ../scripts/test.js",
    "loop-check": "node scripts/solve.js",
    "faces": "cd design && node ../scripts/faces.js",
    "pdf:emblems": "cd dist && node ../scripts/pdf.js emblems",
    "sheet:emblems": "cd dist && node ../scripts/sheet.js \"\" contact-sheet-emblems.png emblems"
  },
  "devDependencies": {
    "@fontsource/nunito": "5.3.0",
    "playwright": "^1.48.0"
  }
}
